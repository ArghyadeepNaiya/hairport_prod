<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Schedule Booking | Ranchi Hair Port</title>
  <meta name="description" content="Schedule your salon appointment at Ranchi Hair Port. Choose your preferred time and location.">
  <link rel="canonical" href="http://localhost:8008/hairport/user/schedule" />
  <meta property="og:title" content="Schedule Booking | Ranchi Hair Port">
  <meta property="og:description" content="Schedule your salon appointment at Ranchi Hair Port.">
  <meta property="og:image" content="https://images.unsplash.com/photo-1560066984-138dadb4c035?q=80&w=1974">
  <meta name="twitter:card" content="summary">
  <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
  <style type="text/tailwindcss">
    @custom-variant dark (&:where(.dark, .dark *));
  </style>
  <link rel="stylesheet" href="/tailwind_base.css" />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js"></script>
  <script>
    if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>
</head>
<body class="font-sans antialiased bg-[#FAF9F5] dark:bg-[#0F0F0F] text-[#1C1C1C] dark:text-[#F8F8F8] flex flex-col min-h-screen">

  <header class="sticky top-0 z-30 px-4 py-3 bg-white/90 dark:bg-[#141414]/90 backdrop-blur-xl border-b border-stone-200/60 dark:border-stone-800/60 flex items-center justify-between">
    <a href="/hairport/user/cart" class="flex items-center gap-2 px-2 py-1.5 -ml-2 rounded-xl hover:bg-stone-100 dark:hover:bg-stone-800 transition-colors group">
      <svg class="w-5 h-5 text-[#E23744] group-hover:-translate-x-0.5 transition-transform" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <span class="text-sm font-extrabold text-[#E23744] hidden sm:inline">Back to Cart</span>
    </a>
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-rose-500 to-rose-600 text-white flex items-center justify-center shadow-md shadow-rose-500/20">
        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      </div>
      <h1 class="text-base font-black text-[#1C1C1C] dark:text-[#F8F8F8]">Schedule</h1>
    </div>
    <div class="flex items-center gap-2">
      <button onclick="const isDark = document.documentElement.classList.toggle('dark'); localStorage.setItem('theme', isDark ? 'dark' : 'light');" class="w-9 h-9 rounded-xl flex items-center justify-center bg-stone-100 dark:bg-stone-800 text-stone-600 dark:text-stone-300 hover:bg-stone-200 dark:hover:bg-stone-700 transition-colors">
        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      </button>
    </div>
  </header>

  <main class="flex-1 w-full max-w-2xl mx-auto px-4 sm:px-6 py-5 flex flex-col gap-6">

    <!-- Progress Steps -->
    <div class="w-full flex items-center justify-between relative px-2">
      <div class="absolute top-1/2 left-6 right-6 h-0.5 bg-stone-200 dark:bg-stone-800 -translate-y-1/2 rounded-full"></div>
      <div class="absolute top-1/2 left-6 h-0.5 bg-gradient-to-r from-[#E23744] to-rose-400 -translate-y-1/2 rounded-full transition-all duration-500" style="width:66%"></div>
      
      <div class="flex flex-col items-center gap-1.5 relative z-10">
        <div class="w-9 h-9 rounded-full bg-gradient-to-br from-[#E23744] to-rose-500 text-white flex items-center justify-center font-extrabold shadow-lg shadow-rose-500/30 ring-4 ring-rose-500/15">
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        </div>
        <span class="text-[10px] font-black text-[#E23744] uppercase tracking-wider">Cart</span>
      </div>
      
      <div class="flex flex-col items-center gap-1.5 relative z-10">
        <div class="w-9 h-9 rounded-full bg-gradient-to-br from-[#E23744] to-rose-500 text-white flex items-center justify-center font-extrabold shadow-lg shadow-rose-500/30 ring-4 ring-rose-500/15">
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <span class="text-[10px] font-black text-[#E23744] uppercase tracking-wider">Schedule</span>
      </div>

      <div class="flex flex-col items-center gap-1.5 relative z-10">
        <div class="w-9 h-9 rounded-full bg-white dark:bg-stone-800 text-stone-400 border-2 border-stone-300 dark:border-stone-700 flex items-center justify-center">
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
        </div>
        <span class="text-[10px] font-bold text-stone-400 uppercase tracking-wider">Checkout</span>
      </div>
    </div>

    <!-- Schedule Form -->
    <div class="bg-white dark:bg-[#1E1E1E] rounded-3xl p-6 border border-stone-200 dark:border-stone-800 shadow-sm mt-4">
        <h2 class="text-lg font-black text-[#1C1C1C] dark:text-white mb-6">Select Details</h2>
        <form id="schedule-form" action="/hairport/user/cart/book" method="POST" class="space-y-5">
            <div class="space-y-1.5">
                <label class="text-[11px] font-extrabold uppercase tracking-wider text-stone-500">Choose Salon Center</label>
                <select name="location" class="w-full px-4 py-3.5 bg-stone-50 dark:bg-stone-900 text-sm font-black rounded-xl border border-stone-200 dark:border-stone-700 focus:outline-none focus:ring-2 focus:ring-rose-500/30 text-[#1C1C1C] dark:text-white" required>
                    <option value="" disabled selected>Select a location...</option>
                    <option value="Lalpur Center (Opposite Nucleus Mall)">Lalpur Center (Opposite Nucleus Mall)</option>
                    <option value="Lalji Hirji Road Center">Lalji Hirji Road Center</option>
                </select>
            </div>
            
            <input type="hidden" name="date" id="hidden-date" required>
            <input type="hidden" name="time" id="hidden-time" required>

            <div class="space-y-4">
                <div class="space-y-1.5">
                    <label class="text-[11px] font-extrabold uppercase tracking-wider text-stone-500">Preferred Date</label>
                    <div id="date-slots-container" class="grid grid-cols-4 sm:grid-cols-7 gap-2"></div>
                </div>
                <div class="space-y-1.5">
                    <label class="text-[11px] font-extrabold uppercase tracking-wider text-stone-500">Preferred Time</label>
                    <div id="time-slots-container" class="grid grid-cols-3 gap-2"></div>
                </div>
            </div>

            <!-- Bill Summary -->
            <div class="p-4 bg-white dark:bg-stone-900/50 rounded-2xl border border-stone-200 dark:border-stone-800 shadow-sm mt-6 space-y-3">
                <h3 class="text-xs font-black text-stone-500 dark:text-stone-400 uppercase tracking-wider mb-2">Order Summary</h3>
                
                <% if (typeof groupedItems !== 'undefined' && groupedItems.length > 0) { %>
                    <div class="space-y-2 pb-3 border-b border-stone-200 dark:border-stone-800">
                        <% groupedItems.forEach(group => { %>
                            <div class="flex justify-between items-start text-sm">
                                <div class="text-stone-700 dark:text-stone-300 pr-4">
                                    <span class="font-bold text-[#1C1C1C] dark:text-white"><%= group.quantity %>x</span> <%= group.item.name %>
                                </div>
                                <span class="font-bold text-[#1C1C1C] dark:text-white whitespace-nowrap">₹<%= group.item.price * group.quantity %></span>
                            </div>
                        <% }) %>
                    </div>
                <% } %>

                <div class="flex justify-between items-center text-sm font-black text-[#1C1C1C] dark:text-white pt-1">
                    <span>Total</span>
                    <span class="text-[#E23744] text-lg">₹<%= typeof subtotal !== 'undefined' ? subtotal : 0 %></span>
                </div>
            </div>

            <!-- Special Remarks -->
            <div class="space-y-1.5 mt-4">
                <label class="text-[11px] font-extrabold uppercase tracking-wider text-stone-500 flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5 text-[#E23744]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/></svg>
                    <span>Special Remarks (Optional)</span>
                </label>
                <textarea name="remark" placeholder="E.g. I want a specific stylist, allergic to certain products..." rows="3" maxlength="300" class="w-full px-4 py-3 bg-stone-50 dark:bg-stone-900 text-sm font-medium rounded-xl border border-stone-200 dark:border-stone-700 text-[#1C1C1C] dark:text-white focus:outline-none focus:ring-2 focus:ring-rose-500/30 resize-none placeholder:text-stone-400 shadow-sm"></textarea>
            </div>

            <div class="pt-4 flex items-center justify-between gap-4 mt-4">
                <a href="/hairport/user/cart" class="w-1/3 py-3.5 rounded-xl border-2 border-stone-200 dark:border-stone-700 text-stone-600 dark:text-stone-300 font-black text-sm uppercase tracking-wider text-center hover:bg-stone-50 dark:hover:bg-stone-800 transition-colors">Back</a>
                <button type="submit" class="w-2/3 py-3.5 rounded-xl bg-gradient-to-r from-[#E23744] to-rose-500 hover:from-[#CB202D] hover:to-rose-600 text-white font-black text-sm uppercase tracking-wider shadow-lg shadow-rose-500/25 active:scale-[0.97] transition-all flex items-center justify-center gap-2">
                    Book Now • ₹<%= typeof subtotal !== 'undefined' ? subtotal : 0 %>
                    <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </button>
            </div>
        </form>
    </div>
  </main>
  
  <script>
      document.addEventListener('DOMContentLoaded', () => {
          const hiddenDate = document.getElementById('hidden-date');
          const hiddenTime = document.getElementById('hidden-time');
          const datesContainer = document.getElementById('date-slots-container');
          const timesContainer = document.getElementById('time-slots-container');
          
          let selectedDateStr = '';
          let selectedTimeStr = '';

          // Generate next 7 days
          const daysList = [];
          for (let i = 0; i < 7; i++) {
            const d = new Date();
            d.setDate(d.getDate() + i);
            const yyyy = d.getFullYear();
            const mm = String(d.getMonth() + 1).padStart(2, '0');
            const dd = String(d.getDate()).padStart(2, '0');
            daysList.push({
              dateStr: `${yyyy}-${mm}-${dd}`,
              dayName: d.toLocaleDateString('en-US', { weekday: 'short' }),
              dateNum: d.getDate(),
              monthName: d.toLocaleDateString('en-US', { month: 'short' })
            });
          }

          // Pre-defined time slots
          const timeSlots = [
            "10:00 AM", "11:00 AM", "12:00 PM",
            "01:00 PM", "02:00 PM", "03:00 PM",
            "04:00 PM", "05:00 PM", "06:00 PM",
            "07:00 PM", "08:00 PM"
          ];

          // Restore pending data if any
          const cookies = document.cookie.split(';');
          let pendingData = null;
          cookies.forEach(c => {
              if (c.trim().startsWith('pendingOrderData=')) {
                  try {
                      pendingData = JSON.parse(decodeURIComponent(c.trim().substring('pendingOrderData='.length)));
                  } catch(e) {}
              }
          });

          if (pendingData) {
              if (pendingData.location) {
                  const locSelect = document.querySelector('[name="location"]');
                  if (locSelect) locSelect.value = pendingData.location;
              }
              if (pendingData.date) selectedDateStr = pendingData.date;
              if (pendingData.time) selectedTimeStr = pendingData.time;
              if (pendingData.remark) {
                  const rem = document.querySelector('[name="remark"]');
                  if (rem) rem.value = pendingData.remark;
              }
              document.cookie = 'pendingOrderData=; path=/; max-age=0';
          }

          function renderUI() {
            // Render Dates
            datesContainer.innerHTML = daysList.map(day => {
              const sel = selectedDateStr === day.dateStr;
              return `
              <button type="button" data-action="set-date" data-date="${day.dateStr}" class="p-3 rounded-2xl text-center border transition-all ${sel ? 'bg-[#E23744] text-white border-transparent font-extrabold shadow-md shadow-rose-900/20 scale-105' : 'bg-stone-50 dark:bg-stone-900 text-stone-700 dark:text-stone-300 border-stone-200 dark:border-stone-800 hover:bg-stone-100 dark:hover:bg-stone-800'}">
                <div class="text-[10px] uppercase opacity-80 mb-0.5">${day.dayName}</div>
                <div class="text-base font-black">${day.dateNum}</div>
                <div class="text-[10px] opacity-70 mt-0.5">${day.monthName}</div>
              </button>`;
            }).join('');

            // Render Times
            timesContainer.innerHTML = timeSlots.map(time => {
              const sel = selectedTimeStr === time;
              return `
              <button type="button" data-action="set-time" data-time="${time}" class="py-3 px-1 rounded-xl text-center border transition-all ${sel ? 'bg-stone-900 text-white dark:bg-stone-100 dark:text-stone-950 font-black border-transparent shadow-md scale-105' : 'bg-stone-50 dark:bg-stone-900 text-stone-700 dark:text-stone-300 border-stone-200 dark:border-stone-800 hover:bg-stone-100 dark:hover:bg-stone-800'}">
                <div class="text-xs font-bold">${time}</div>
              </button>`;
            }).join('');
            
            // Sync hidden inputs
            hiddenDate.value = selectedDateStr;
            hiddenTime.value = selectedTimeStr;
          }

          // Initial Render
          renderUI();

          // Event Delegation for clicks
          document.addEventListener('click', e => {
            const btn = e.target.closest('[data-action]');
            if (!btn) return;
            
            if (btn.dataset.action === 'set-date') {
              selectedDateStr = btn.dataset.date;
              renderUI();
            } else if (btn.dataset.action === 'set-time') {
              selectedTimeStr = btn.dataset.time;
              renderUI();
            }
          });

          // Handle form submission with confetti
          const scheduleForm = document.getElementById('schedule-form');
          if (scheduleForm) {
            scheduleForm.addEventListener('submit', (e) => {
              e.preventDefault();
              
              // If user is a guest, save data and redirect to login
              if (!<%= isLoggedIn %>) {
                  const formData = new FormData(scheduleForm);
                  const data = {
                      location: formData.get('location'),
                      date: formData.get('date'),
                      time: formData.get('time'),
                      remark: formData.get('remark')
                  };
                  document.cookie = `pendingOrderData=${encodeURIComponent(JSON.stringify(data))}; path=/; max-age=3600`;
                  document.cookie = `postLoginRedirect=/hairport/user/cart/schedule; path=/; max-age=3600`;
                  window.location.href = "/hairport/user/login";
                  return;
              }

              // Fire confetti
              confetti({
                particleCount: 150,
                spread: 90,
                origin: { y: 0.6 },
                colors: ['#E23744', '#f59e0b', '#10b981', '#ffffff'],
                zIndex: 9999
              });

              // Delay actual submission
              setTimeout(() => {
                scheduleForm.submit();
              }, 1500);
            });
          }
      });
  </script>
</body>
</html>
