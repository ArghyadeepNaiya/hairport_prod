<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Academy | Ranchi Hair Port</title>
  <meta name="description" content="Join the Ranchi Hair Port Academy. Learn premium salon techniques, hair styling, and beauty courses from industry experts.">
  <link rel="canonical" href="http://localhost:8008/hairport/user/academy" />
  <meta property="og:title" content="Ranchi Hair Port Academy">
  <meta property="og:description" content="Learn premium salon techniques, hair styling, and beauty courses from industry experts at Ranchi Hair Port.">
  <meta property="og:image" content="https://images.unsplash.com/photo-1521590832167-7bfc17484d20?q=80&w=2070">
  <meta property="og:url" content="http://localhost:8008/hairport/user/academy">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" type="image/svg+xml" href="/src/assets/svgs/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
  <style type="text/tailwindcss">
    @custom-variant dark (&:where(.dark, .dark *));
  </style>
  <link rel="stylesheet" href="/tailwind_base.css" />
  <script>
    if (localStorage.getItem('theme') === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>
</head>
<body class="font-sans antialiased">
  <div id="app" class="min-h-screen bg-[#FAF9F5] dark:bg-[#0F0F0F] text-[#1C1C1C] dark:text-[#F8F8F8] flex flex-col transition-colors duration-300 overflow-x-hidden pb-20 lg:pb-0">

    <!-- 1. Header -->
    <header class="sticky top-0 z-50 bg-stone-950 border-b border-stone-800 transition-colors duration-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between py-3 md:py-0 md:h-16">
          <div class="flex items-center gap-3">
            <button onclick="window.location.href='/hairport/user/home'" aria-label="Go Back" class="w-9 h-9 rounded-xl flex items-center justify-center bg-white/10 text-white hover:bg-white/20 transition-colors">
              <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <div class="flex flex-col gap-0.5 items-start">
              <div class="flex items-center gap-1.5">
                <svg class="w-5 h-5 text-[#E23744] shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12"/></svg>
                <span class="text-sm sm:text-xl font-black tracking-tight text-white">RANCHI HAIR PORT</span>
                <span class="hidden sm:inline-block text-[10px] font-extrabold uppercase tracking-widest px-2 py-0.5 bg-white/15 text-white rounded-full border border-white/20">SALON</span>
              </div>
            </div>
          </div>
          
          <div class="flex items-center gap-1.5 sm:gap-2">
            <button data-action="toggle-theme" aria-label="Toggle Theme" class="w-9 h-9 rounded-xl flex items-center justify-center bg-white/10 text-white hover:bg-white/20 transition-colors">
              <svg id="theme-icon" class="w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
            </button>
            <button onclick="window.location.href='/hairport/user/cart'" aria-label="Cart" class="relative w-9 h-9 rounded-xl flex items-center justify-center bg-white/10 text-white hover:bg-white/20 transition-colors">
              <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
              
<% if (cartItemCount > 0) { %>
    <span id="nav-cart-badge" class="absolute -top-1 -right-1 w-4 h-4 bg-[#E23744] text-white text-[10px] font-extrabold rounded-full items-center justify-center ring-2 ring-stone-950 flex"><%= cartItemCount %></span>
<% } else { %>
    <span id="nav-cart-badge" class="hidden absolute -top-1 -right-1 w-4 h-4 bg-[#E23744] text-white text-[10px] font-extrabold rounded-full items-center justify-center ring-2 ring-stone-950"></span>
<% } %>

            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- 2. Academy Hero Section -->
    <div class="w-full bg-white dark:bg-[#0F0F0F] pt-6 pb-6 px-4 sm:px-6">
      <div class="max-w-5xl mx-auto flex flex-col items-start text-left space-y-4">
        
        <div class="flex justify-between w-full items-start">
          <div>
            <h1 class="text-3xl sm:text-4xl font-black text-stone-900 dark:text-white leading-tight">
              Ranchi Hairport<br />Academy
            </h1>
          </div>
        </div>

        <div class="space-y-1">
          <p class="text-sm sm:text-base font-bold text-stone-600 dark:text-stone-300">Professional Beauty & Wellness Training</p>
          <p class="text-xs sm:text-sm text-stone-500 dark:text-stone-400">Mall Decore, Lalpur Chowk, Ranchi</p>
        </div>

        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-rose-50 dark:bg-rose-900/20 text-[#E23744] text-[10px] sm:text-xs font-bold uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-[#E23744] animate-pulse"></span>
          Admission Open • Limited Seats
        </div>
        
        <div class="flex flex-row items-center gap-6 pt-2">
          <div class="flex items-center gap-2 text-stone-600 dark:text-stone-300">
            <svg class="w-4 h-4 sm:w-5 sm:h-5 text-stone-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span class="text-xs sm:text-sm font-semibold">1 to 6 Months</span>
          </div>
          <div class="flex items-center gap-2 text-stone-600 dark:text-stone-300">
            <svg class="w-4 h-4 sm:w-5 sm:h-5 text-stone-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <div class="flex flex-col text-left leading-tight">
              <span class="text-xs sm:text-sm font-semibold">Training Center</span>
              <span class="text-[10px] sm:text-xs text-stone-500">6th Floor</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Feature Pills -->
    <div class="bg-white/80 dark:bg-[#121212]/80 backdrop-blur-md border-b border-stone-200 dark:border-stone-800 py-4 shadow-sm z-30 sticky top-0 md:top-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="flex flex-nowrap items-center md:justify-center gap-4 overflow-x-auto no-scrollbar pb-1">
          <div class="flex items-center gap-3 shrink-0 bg-emerald-50 dark:bg-emerald-950/30 px-4 py-2.5 rounded-2xl border border-emerald-200 dark:border-emerald-800/50">
            <div class="w-8 h-8 rounded-full bg-emerald-500 text-white flex items-center justify-center font-bold">🟢</div>
            <div class="flex flex-col"><span class="text-[10px] font-black uppercase text-emerald-600 dark:text-emerald-400">Job Assistance</span><span class="text-xs font-bold text-stone-800 dark:text-stone-200">100% Guaranteed Placement</span></div>
          </div>
          
          <div class="flex items-center gap-3 shrink-0 bg-rose-50 dark:bg-rose-950/30 px-4 py-2.5 rounded-2xl border border-rose-200 dark:border-rose-800/50">
            <div class="w-8 h-8 rounded-full bg-rose-500 text-white flex items-center justify-center font-bold">⭐</div>
            <div class="flex flex-col"><span class="text-[10px] font-black uppercase text-rose-600 dark:text-rose-400">Certified</span><span class="text-xs font-bold text-stone-800 dark:text-stone-200">Professional Training</span></div>
          </div>
          
          <div class="flex items-center gap-3 shrink-0 bg-amber-50 dark:bg-amber-950/30 px-4 py-2.5 rounded-2xl border border-amber-200 dark:border-amber-800/50">
            <div class="w-8 h-8 rounded-full bg-amber-500 text-white flex items-center justify-center font-bold">💯</div>
            <div class="flex flex-col"><span class="text-[10px] font-black uppercase text-amber-600 dark:text-amber-400">Practical</span><span class="text-xs font-bold text-stone-800 dark:text-stone-200">Practice on Real Models</span></div>
          </div>
        </div>
      </div>
    </div>

    <!-- 4. Full Courses Section -->
    <main class="flex-1 max-w-5xl mx-auto w-full px-4 sm:px-6 py-10">
      <h2 class="text-2xl sm:text-3xl font-black text-[#1C1C1C] dark:text-[#F8F8F8] mb-8">Full Courses</h2>
      
      <div id="academy-courses-container" class="space-y-6">

<% academy_listings.forEach((listing, index) => { %>
    <div class="bg-white dark:bg-[#1E1E1E] rounded-3xl p-4 sm:p-6 border border-stone-200/80 dark:border-stone-800 shadow-sm transition-all duration-200 mb-6">
      <div class="flex flex-row gap-3 sm:gap-6">
        <div class="flex-1 space-y-2 sm:space-y-3 min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-[11px] font-bold text-stone-500 dark:text-stone-400">Duration: <%= listing.duration_months %> Months</span>
          </div>
          <h3 class="text-base sm:text-2xl font-black text-[#1C1C1C] dark:text-[#F8F8F8] leading-tight"><%= listing.name %></h3>
          <div class="flex items-center gap-4">
            <div class="flex items-baseline gap-1.5 sm:gap-2">
              <span class="text-lg sm:text-2xl font-black text-[#1C1C1C] dark:text-white">₹<%= listing.price %></span>
            </div>
          </div>
          <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-300 leading-relaxed font-medium"><%= listing.description %></p>
        </div>
        <div class="w-[110px] sm:w-[140px] shrink-0 flex flex-col gap-2 sm:gap-3">
          <div class="relative w-full aspect-square rounded-2xl overflow-hidden bg-stone-100 dark:bg-stone-800 shadow-md">
            <img src="<%= listing.image %>" alt="<%= listing.name %> Course Image" class="w-full h-full object-cover" />
          </div>
          <div class="w-full">
            <% if (typeof purchasedItemIds !== 'undefined' && purchasedItemIds.includes(listing._id.toString())) { %>
                <button disabled class="w-full py-2 px-1 sm:py-2.5 sm:px-4 bg-stone-100 dark:bg-stone-800 text-stone-400 font-black text-[11px] sm:text-sm uppercase tracking-wider rounded-xl border-2 border-stone-200 dark:border-stone-700 shadow-sm flex items-center justify-center gap-1 cursor-not-allowed">
                  <span>PURCHASED ✓</span>
                </button>
            <% } else if (typeof cartItemIds !== 'undefined' && cartItemIds.includes(listing._id.toString())) { %>
                <a href="/hairport/user/cart" class="w-full py-2 px-1 sm:py-2.5 sm:px-4 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-500 font-black text-[11px] sm:text-sm uppercase tracking-wider rounded-xl border-2 border-emerald-500/40 hover:bg-emerald-100 dark:hover:bg-emerald-900/50 shadow-sm active:scale-95 transition-all flex items-center justify-center gap-1 text-center">
                  <span>ADDED ✓</span>
                </a>
            <% } else { %>
                 <form action="/hairport/user/cart/add/<%= listing._id %>" method="POST" style="margin:0;">
                    <button type="submit" class="w-full py-2 px-1 sm:py-2.5 sm:px-4 bg-white dark:bg-stone-900 text-[#E23744] font-black text-[11px] sm:text-sm uppercase tracking-wider rounded-xl border-2 border-[#E23744]/40 hover:bg-rose-50 dark:hover:bg-rose-950/40 shadow-sm active:scale-95 transition-all flex items-center justify-center gap-1">
                      <span>ENROLL +</span>
                    </button>
                 </form>
            <% } %>
          </div>
        </div>
      </div>
    </div>
<% }) %>

      </div>
    </main>

    <!-- 5. Sticky Bottom Bar -->
    <div class="fixed bottom-0 left-0 right-0 z-40 bg-white dark:bg-[#1E1E1E] border-t border-stone-200 dark:border-stone-800 p-3 sm:p-4 pb-safe shadow-[0_-4px_20px_-10px_rgba(0,0,0,0.1)] anim-slide-up">
      <div class="max-w-5xl mx-auto flex items-center justify-between gap-2 sm:gap-4">
        <div class="flex flex-col min-w-0">
          <span class="text-[10px] sm:text-xs font-bold text-stone-500 dark:text-stone-400 uppercase tracking-wide">QUESTIONS?</span>
          <span class="text-xs sm:text-base font-extrabold text-[#1C1C1C] dark:text-white truncate">Speak to our Counselors</span>
        </div>
        <a href="tel:+919876543210" class="shrink-0 flex items-center justify-center gap-1.5 sm:gap-2 bg-[#E23744] hover:bg-[#CB202D] text-white px-4 py-2 sm:px-6 sm:py-3 rounded-xl sm:rounded-2xl font-black text-xs sm:text-base uppercase tracking-wide shadow-lg shadow-rose-900/40 active:scale-95 transition-all">
          <svg class="w-3 h-3 sm:w-4 sm:h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          CALL NOW
        </a>
      </div>
    </div>
    
    <div class="h-24"></div> <!-- padding for sticky bar -->

  </div>

  <!-- 6. Floating Cart Bar -->
  
<% if (cartItemCount > 0) { %>
  <div class="floating-cart-popup fixed bottom-0 left-0 right-0 z-50 p-3 sm:p-4 bg-gradient-to-t from-stone-950 via-stone-950/95 to-transparent pb-safe anim-slide-up pointer-events-none">
    <div id="floating-cart-inner" class="pointer-events-auto bg-[#1C1C1C] text-white rounded-2xl sm:rounded-3xl p-3 sm:p-3.5 shadow-2xl border border-stone-800 flex items-center justify-between backdrop-blur-md max-w-7xl mx-auto transition-all duration-300 transform origin-bottom mb-[70px]">
      <div class="flex items-center gap-3 pl-1">
        <div id="floating-cart-bag" class="relative w-10 h-10 rounded-2xl bg-[#E23744] text-white flex items-center justify-center font-black shadow-md shadow-rose-900/40">
          <span class="absolute -top-1.5 -right-1.5 w-5 h-5 bg-amber-400 text-stone-950 text-xs font-black rounded-full flex items-center justify-center ring-2 ring-stone-950 transition-all"><%= cartItemCount %></span>
        </div>
        <div>
          <div class="flex items-baseline gap-1.5"><span id="floating-cart-subtotal" class="inline-block text-base sm:text-lg font-black text-white transition-all duration-300 transform">₹<%= cartTotal %></span></div>
        </div>
      </div>
      <a href="/hairport/user/cart" class="flex items-center gap-2 px-4 sm:px-5 py-2.5 rounded-xl sm:rounded-2xl bg-[#E23744] hover:bg-[#CB202D] text-white font-extrabold text-xs uppercase tracking-wider shadow-lg shadow-rose-900/40 active:scale-95 transition-all duration-300"><span>VIEW CART</span></a>
    </div>
  </div>
<% } %>


  
  <script>
    const themeBtn = document.querySelector('[data-action="toggle-theme"]');
    if(themeBtn) {
        themeBtn.addEventListener('click', () => {
            const isDark = document.documentElement.classList.toggle('dark'); localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
    }
  </script>

</body>
</html>
