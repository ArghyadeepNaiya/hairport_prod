<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Academy | Ranchi Hair Port</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/academy.css">
    <link rel="stylesheet" href="/styles.css"> <!-- Reuses cart popup styles -->
</head>
<body style="background-color: #faf9f6; padding-bottom: 100px;">

    <!-- Navigation Header (Optional, allows returning to home) -->
    <header class="navbar" style="background: white; margin-bottom: 20px;">
        <div class="nav-left">
            <a href="/hairport/user/home" style="text-decoration: none; color: inherit;">
                <div class="logo"><h1>RANCHI HAIR PORT <span class="badge">SALON</span></h1></div>
            </a>
        </div>
    </header>

    <div class="academy-container">
        <!-- Header Section -->
        <div class="academy-header">
            <h1>Ranchi Hairport<br>Academy</h1>
            <h3>Professional Beauty & Wellness Training</h3>
            <p class="location">Mall Decore, Lalpur Chowk, Ranchi</p>
            
            <div class="status-badge">
                <i class="fa-solid fa-circle"></i> ADMISSION OPEN • LIMITED SEATS
            </div>

            <div class="quick-info">
                <span><i class="fa-regular fa-clock"></i> 1 to 6 Months</span>
                <span><i class="fa-solid fa-location-dot"></i> Training Center<br><small>6th Floor</small></span>
            </div>

            <div class="features-grid">
                <div class="feature-box green">
                    <div class="f-icon"><i class="fa-solid fa-shield-halved"></i></div>
                    <div class="f-text"><span>JOB ASSISTANCE</span><br>100% Guaranteed Placement</div>
                </div>
                <div class="feature-box pink">
                    <div class="f-icon"><i class="fa-solid fa-certificate"></i></div>
                    <div class="f-text"><span>CERTIFIED</span><br>Professional Training</div>
                </div>
                <div class="feature-box yellow">
                    <div class="f-icon"><i class="fa-solid fa-100"></i></div>
                    <div class="f-text"><span>PRACTICAL</span><br>Practice on Real Models</div>
                </div>
            </div>
        </div>

        <!-- Courses Section -->
        <div class="courses-section">
            <h2>Full Courses</h2>
            
            <% for(let course of academy_listings) { %>
                <div class="course-card">
                    <div class="course-details">
                        <div class="tags">
                            <% if (course.is_bestseller) { %>
                                <span class="tag-bestseller"><i class="fa-solid fa-star"></i> BESTSELLER</span>
                            <% } %>
                            <span class="tag-duration">Duration: <%= course.duration %></span>
                        </div>
                        <h4><%= course.name %></h4>
                        <div class="price-row">
                            <span class="current">₹<%= course.price %></span>
                            <% if(course.original_price) { %> <span class="original">₹<%= course.original_price %></span> <% } %>
                        </div>
                        <p class="desc"><%= course.description %></p>
                        <span class="show-more">Show more v</span>
                    </div>
                    <div class="course-action">
                        <img src="<%= course.image %>" alt="<%= course.name %>">
                        <form action="/hairport/user/cart/add/<%= course._id %>" method="POST" style="margin:0;">
                            <button type="submit" class="enroll-btn">ENROLL +</button>
                        </form>
                    </div>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Reused Floating Cart Popup -->
    <% if (cartItemCount > 0) { %>
        <div class="floating-cart-popup">
            <div class="cart-info-left">
                <div class="cart-icon-wrapper">
                    <i class="fa-solid fa-bag-shopping"></i>
                    <span class="cart-badge"><%= cartItemCount %></span>
                </div>
                <div class="cart-price-details">
                    <span class="cart-total">₹<%= cartTotal %></span>
                    <span class="cart-subtitle">
                        Academy Registration
                        <% if (userSubscribed) { %> <span class="discount-text">• 5% VIP Discount</span> <% } %>
                    </span>
                </div>
            </div>
            <a href="/hairport/user/cart" class="btn view-cart-btn">VIEW CART <i class="fa-solid fa-arrow-right"></i></a>
        </div>
    <% } %>

</body>
</html>