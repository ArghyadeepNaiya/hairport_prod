<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Owner Dashboard | Ranchi Hair Port</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/owner.css">
</head>
<body class="owner-body">
    
    <div class="dashboard-nav">
        <h2>Salon Management</h2>
        <div style="display: flex; gap: 10px;">
            <a href="/hairport/owner/listing/new" class="btn" style="width: auto; padding: 8px 15px;">+ Create Listing</a>
            <a href="/hairport/owner/logout" class="btn outline">Logout</a>
        </div>
    </div>

    <div class="owner-card" style="max-width: 800px;">
        <h3>Active Customer Bookings</h3>
        
        <% if (typeof orders !== 'undefined' && orders.length > 0) { %>
            <% orders.forEach(order => { %>
                <div style="background: #f9f9f9; padding: 15px; border-radius: 8px; margin-bottom: 15px; border: 1px solid #eee; display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <p style="font-weight: 600; margin-bottom: 5px;">
                            <%= order.user ? order.user.username : 'Unknown User' %> 
                            <span style="color: #777; font-size: 0.85rem;">(<%= order.user ? order.user.phone : 'No Phone' %>)</span>
                        </p>
                        <p style="font-size: 0.9rem; margin-bottom: 3px;"><strong>Location:</strong> <%= order.location %></p>
                        <p style="font-size: 0.9rem; margin-bottom: 3px;"><strong>Date/Time:</strong> <%= order.date %> at <%= order.time %></p>
                        <p style="font-size: 0.9rem; color: #2ecc71; font-weight: 600;">Total Paid: ₹<%= order.total %></p>
                    </div>
                    
                    <!-- The Finish Button triggers a DELETE request via method-override -->
                    <form action="/hairport/owner/order/<%= order._id %>?_method=DELETE" method="POST" style="margin: 0;">
                        <button type="submit" class="btn outline" style="border-color: #2ecc71; color: #2ecc71;">Finish ✓</button>
                    </form>
                </div>
            <% }) %>
        <% } else { %>
            <p style="color: #777; text-align: center; padding: 20px 0;">No active orders currently.</p>
        <% } %>
    </div>

</body>
</html>