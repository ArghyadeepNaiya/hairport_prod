  <!-- Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <div class="flex gap-16">
      
      <!-- Sticky TOC (desktop only) -->
      <aside class="hidden lg:block w-56 shrink-0">
        <nav class="sticky top-24 space-y-6">
          <p class="text-[10px] font-black uppercase tracking-widest text-stone-400 dark:text-stone-500 mb-4">On this page</p>
          <a href="#section-01" class="toc-link flex items-baseline gap-3 group cursor-pointer">
            <span class="text-[10px] font-black text-[#E23744] tracking-widest">01</span>
            <span class="text-xs font-bold text-stone-500 dark:text-stone-400 group-hover:text-stone-900 dark:group-hover:text-white transition-colors">Information We Collect</span>
          </a>
          <a href="#section-02" class="toc-link flex items-baseline gap-3 group cursor-pointer">
            <span class="text-[10px] font-black text-[#E23744] tracking-widest">02</span>
            <span class="text-xs font-bold text-stone-500 dark:text-stone-400 group-hover:text-stone-900 dark:group-hover:text-white transition-colors">How We Use It</span>
          </a>
