            <span class="text-xs font-bold text-stone-500 dark:text-stone-400 group-hover:text-stone-900 dark:group-hover:text-white transition-colors">Data Security</span>
          </a>
          <a href="#section-04" class="toc-link flex items-baseline gap-3 group cursor-pointer">
            <span class="text-[10px] font-black text-[#E23744] tracking-widest">04</span>
            <span class="text-xs font-bold text-stone-500 dark:text-stone-400 group-hover:text-stone-900 dark:group-hover:text-white transition-colors">Sharing Info</span>
          </a>
          <a href="#section-05" class="toc-link flex items-baseline gap-3 group cursor-pointer">
            <span class="text-[10px] font-black text-[#E23744] tracking-widest">05</span>
            <span class="text-xs font-bold text-stone-500 dark:text-stone-400 group-hover:text-stone-900 dark:group-hover:text-white transition-colors">Policy Changes</span>
          </a>
          <a href="#section-06" class="toc-link flex items-baseline gap-3 group cursor-pointer">
            <span class="text-[10px] font-black text-[#E23744] tracking-widest">06</span>
            <span class="text-xs font-bold text-stone-500 dark:text-stone-400 group-hover:text-stone-900 dark:group-hover:text-white transition-colors">Contact Us</span>
          </a>
