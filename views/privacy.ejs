  <!-- Hero -->
  <section class="relative bg-[#0A0A0A] text-white py-24 sm:py-32 overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-rose-600/8 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
