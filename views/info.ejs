<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Info & About Us | Ranchi Hair Port</title>
  <link rel="icon" type="image/svg+xml" href="/src/assets/svgs/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
  <style type="text/tailwindcss">
    @custom-variant dark (&:where(.dark, .dark *));
  </style>
  <link rel="stylesheet" href="/tailwind_base.css" />
  <script>
    if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>
</head>
<body class="font-sans antialiased bg-[#FAF9F5] dark:bg-[#0F0F0F] text-[#1C1C1C] dark:text-[#F8F8F8] flex flex-col min-h-screen transition-colors duration-300">
  
  <header class="sticky top-0 z-50 bg-stone-950 border-b border-stone-800 transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between py-3 md:py-0 md:h-16">
        <div class="flex items-center gap-3">
          <button onclick="window.history.back()" aria-label="Go Back" class="w-9 h-9 rounded-xl flex items-center justify-center bg-white/10 text-white hover:bg-white/20 transition-colors">
            <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          </button>
          <div class="flex items-center gap-1.5">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-[#E23744] shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12"/></svg>
            <span class="text-sm sm:text-xl font-black tracking-tight text-white">RANCHI HAIR PORT</span>
          </div>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <button data-action="toggle-theme" aria-label="Toggle Theme" class="w-9 h-9 rounded-xl flex items-center justify-center bg-white/10 text-white hover:bg-white/20 transition-colors">
            <svg id="theme-icon" class="w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          </button>
        </div>
      </div>
    </div>
  </header>

  <main class="flex-1 max-w-4xl mx-auto w-full px-6 py-12">
    <h1 class="text-3xl font-black text-stone-900 dark:text-white mb-8">About Ranchi Hair Port</h1>
    
    <div class="space-y-8 text-stone-600 dark:text-stone-300 text-sm leading-relaxed">
        <section class="space-y-3">
            <h2 class="text-lg font-extrabold text-stone-800 dark:text-stone-100">Welcome to Ranchi Hair Port</h2>
            <p>Ranchi Hair Port is a premium family salon dedicated to providing exceptional grooming and beauty services. We blend modern techniques with personalized care to ensure every client leaves feeling confident and refreshed.</p>
        </section>

        <section class="space-y-3">
            <h2 class="text-lg font-extrabold text-stone-800 dark:text-stone-100">Our Services</h2>
            <p>From classic haircuts and styling to advanced facials, bridal makeup, and luxurious spa treatments, our experienced professionals use only top-tier products to deliver the best results for all genders.</p>
        </section>

        <section class="space-y-3">
            <h2 class="text-lg font-extrabold text-stone-800 dark:text-stone-100">Ranchi Hair Port Academy</h2>
            <p>We believe in empowering the next generation of beauty professionals. Our certified Academy offers comprehensive 1 to 6-month training programs with 100% placement assistance, giving students practical experience on real models.</p>
        </section>

        <section class="space-y-3">
            <h2 class="text-lg font-extrabold text-stone-800 dark:text-stone-100">Our Locations</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-2">
                <div class="p-4 rounded-xl bg-stone-100 dark:bg-stone-900 border border-stone-200 dark:border-stone-800">
                    <h3 class="font-bold text-[#E23744] mb-1">Lalpur Center</h3>
                    <p class="text-xs">Opposite Nucleus Mall, Ranchi, Jharkhand.</p>
                </div>
                <div class="p-4 rounded-xl bg-stone-100 dark:bg-stone-900 border border-stone-200 dark:border-stone-800">
                    <h3 class="font-bold text-[#E23744] mb-1">Lalji Hirji Road Center</h3>
                    <p class="text-xs">Lalji Hirji Road, Ranchi, Jharkhand.</p>
                </div>
            </div>
        </section>
    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const themeBtn = document.querySelector('[data-action="toggle-theme"]');
      if(themeBtn) {
          themeBtn.addEventListener('click', () => {
              const isDark = document.documentElement.classList.toggle('dark');
              localStorage.setItem('theme', isDark ? 'dark' : 'light');
          });
      }
    });
  </script>
</body>
</html>
