  <div id="vip-gold-modal"></div>
  <div id="recommendation-popup"></div>

  <!-- Mobile Menu Drawer -->
  <div id="mobile-menu-drawer" class="fixed inset-0 z-[100] hidden">
    <!-- Backdrop -->
    <div id="mobile-menu-backdrop" data-action="close-mobile-menu" class="absolute inset-0 bg-black/60 backdrop-blur-sm transition-opacity opacity-0 duration-300"></div>
    <!-- Drawer Content -->
    <div id="mobile-menu-content" class="absolute top-0 left-0 w-3/4 max-w-sm h-full bg-white dark:bg-[#0F0F0F] shadow-2xl transition-transform -translate-x-full duration-300 flex flex-col">
      <div class="flex items-center justify-between p-5 border-b border-stone-200 dark:border-stone-800">
        <span class="text-lg font-black tracking-tight text-stone-900 dark:text-white">RANCHI HAIR PORT</span>
        <button id="close-mobile-menu-btn" data-action="close-mobile-menu" class="p-2 rounded-full bg-stone-100 dark:bg-stone-800 text-stone-600 dark:text-stone-300 hover:bg-stone-200 dark:hover:bg-stone-700 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <nav class="flex-1 overflow-y-auto p-5 space-y-2">
        <a href="#" data-action="open-vip-modal" class="block px-4 py-3 rounded-xl text-amber-600 dark:text-amber-500 hover:bg-amber-50 dark:hover:bg-amber-500/10 font-bold transition-colors">VIP Gold Membership</a>
        <a href="#" data-action="go-cart" class="block px-4 py-3 rounded-xl text-stone-700 dark:text-stone-300 hover:bg-stone-100 dark:hover:bg-[#1E1E1E] font-bold transition-colors">View Cart</a>
        <a href="#" onclick="window.location.href='/hairport/user/academy'" class="block px-4 py-3 rounded-xl text-stone-700 dark:text-stone-300 hover:bg-stone-100 dark:hover:bg-[#1E1E1E] font-bold transition-colors">Ranchi Academy</a>
      </nav>
      <div class="p-5 border-t border-stone-200 dark:border-stone-800">
        <div class="flex items-center gap-4">
          <a href="https://www.instagram.com/ranchi_hairport_family_salon/?hl=en" target="_blank" class="p-3 rounded-full bg-stone-100 dark:bg-stone-800 text-stone-600 dark:text-stone-400 hover:text-[#E1306C] transition-colors"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg></a>
        </div>
      </div>
    </div>
