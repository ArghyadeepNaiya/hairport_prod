  <script>
    document.addEventListener("DOMContentLoaded", () => {
        const themeBtn = document.querySelector('[data-action="toggle-theme"]');
        if(themeBtn) {
            themeBtn.addEventListener('click', () => {
                const isDark = document.documentElement.classList.toggle('dark');
                localStorage.setItem('theme', isDark ? 'dark' : 'light');
                document.body.classList.toggle('dark');
                
                const themeIcon = document.getElementById('theme-icon');
                if (themeIcon) {
                    if (isDark) {
                        themeIcon.outerHTML = '<svg id="theme-icon" class="w-4 h-4 text-amber-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>';
                    } else {
                        themeIcon.outerHTML = '<svg id="theme-icon" class="w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>';
                    }
                }
            });
        }

        const openMenuBtn = document.querySelector('[data-action="open-mobile-menu"]');
        const closeMenuBtns = document.querySelectorAll('[data-action="close-mobile-menu"]');
        const drawer = document.getElementById('mobile-menu-drawer');
        const backdrop = document.getElementById('mobile-menu-backdrop');
        const content = document.getElementById('mobile-menu-content');

        if (openMenuBtn && drawer) {
            openMenuBtn.addEventListener('click', () => {
                drawer.classList.remove('hidden');
                setTimeout(() => {
                    backdrop.classList.remove('opacity-0');
                    content.classList.remove('-translate-x-full');
                }, 10);
            });
        }

        closeMenuBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                backdrop.classList.add('opacity-0');
                content.classList.add('-translate-x-full');
                setTimeout(() => {
                    drawer.classList.add('hidden');
                }, 300);
            });
        });

        // Add to cart fetch logic
        const isLoggedInUser = <%= isLoggedIn %>;
        
        const attachCartListeners = () => {
            const cartControls = document.querySelectorAll('.cart-control');
            cartControls.forEach(control => {
                control.addEventListener('click', function(e) {
                    const addBtn = e.target.closest('.btn-add');
                    const removeBtn = e.target.closest('.btn-remove');
                    
                    if (addBtn || removeBtn) {
                        e.preventDefault();
                        if (!isLoggedInUser) {
                            const modal = document.getElementById('auth-required-modal');
                            modal.classList.remove('hidden');
                            modal.classList.add('flex');
                            return;
                        }

                        const listingId = this.dataset.listingId;
                        const actionUrl = addBtn ? `/hairport/user/cart/add/${listingId}` : `/hairport/user/cart/remove/${listingId}`;
                        
                        // Optimistic UI update
                        let currentDisplay = this.querySelector('.count-display');
                        let currentCount = currentDisplay ? parseInt(currentDisplay.innerText) : 0;
                        
                        if (addBtn) currentCount++;
                        if (removeBtn) currentCount--;
                        
                        if (currentCount > 0) {
                            this.innerHTML = `
                              <div class="flex items-center justify-between w-full h-[34px] border-2 border-[#E23744] rounded-xl overflow-hidden bg-transparent">
                                <button type="button" class="btn-remove w-1/3 h-full flex items-center justify-center text-[#E23744] hover:bg-rose-50 transition-colors">
                                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                </button>
                                <span class="count-display w-1/3 text-center text-[#E23744] font-black text-xs">${currentCount}</span>
                                <button type="button" class="btn-add w-1/3 h-full flex items-center justify-center text-[#E23744] hover:bg-rose-50 transition-colors">
                                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                </button>
                              </div>
                            `;
                        } else {
                            this.innerHTML = `
                              <button type="button" class="btn-add initial-add-btn w-full h-[34px] bg-white dark:bg-stone-900 text-[#E23744] font-black text-xs uppercase tracking-wider rounded-xl border-2 border-[#E23744]/40 hover:bg-rose-50 dark:hover:bg-rose-950/40 shadow-sm active:scale-95 transition-all flex items-center justify-center gap-1"><span>ADD</span>+</button>
                            `;
                        }

                        // Perform fetch
                        fetch(actionUrl, { method: 'POST', redirect: 'follow' })
                        .then(res => res.text())
                        .then(html => {
                            const doc = new DOMParser().parseFromString(html, 'text/html');
                            // Update cart UI popup
                            const newPopup = doc.querySelector('.floating-cart-popup');
                            const existingPopup = document.querySelector('.floating-cart-popup');
                            if (newPopup) {
                                if (existingPopup) existingPopup.replaceWith(newPopup);
                                else document.body.appendChild(newPopup);
                            } else if (existingPopup) {
                                existingPopup.remove(); // Cart is completely empty now
                            }
                            
                            const newBadge = doc.querySelector('#nav-cart-badge');
                            const existingBadge = document.querySelector('#nav-cart-badge');
                            if (newBadge && existingBadge) {
                                existingBadge.replaceWith(newBadge);
                            }
                            
                            const cartBtn = document.querySelector('button[aria-label="Cart"]');
                            if (cartBtn) {
                                cartBtn.style.transition = 'transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
                                cartBtn.style.transform = 'scale(1.25)';
                                setTimeout(() => {
                                    cartBtn.style.transform = 'scale(1)';
                                }, 250);
                            }
                        });
                    }
                });
            });
        };
        attachCartListeners();
        
        // Sync Location Select with Active Center display
        const locationSelect = document.getElementById('index-branch-select');
        const activeCenterDisplay = document.getElementById('catalog-active-center');
        if(locationSelect && activeCenterDisplay) {
            // Check if there's a saved location in localStorage
            const savedLocation = localStorage.getItem('hairport_active_location');
            if(savedLocation) {
                locationSelect.value = savedLocation;
                activeCenterDisplay.textContent = savedLocation;
            }

            locationSelect.addEventListener('change', function() {
                activeCenterDisplay.textContent = this.value;
                localStorage.setItem('hairport_active_location', this.value);
            });
        }
    });
  </script>

</body>
</html>
