<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <link rel="icon" type="image/svg+xml" href="/src/assets/svgs/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Page Not Found | Ranchi Hair Port</title>
  <meta name="description" content="The page you are looking for does not exist. Return to Ranchi Hair Port.">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,900;1,400&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
  <style type="text/tailwindcss">
    @custom-variant dark (&:where(.dark, .dark *));
  </style>
  <link rel="stylesheet" href="/tailwind_base.css" />
  <script>
    if (localStorage.getItem('theme') === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>
  <style>
    @keyframes snip {
      0%, 100% { transform: rotate(0deg); }
      25% { transform: rotate(-15deg); }
      75% { transform: rotate(15deg); }
    }
    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-12px); }
    }
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .anim-snip { animation: snip 3s ease-in-out infinite; }
    .anim-float { animation: float 5s ease-in-out infinite; }
    .anim-fade-1 { animation: fadeInUp 0.8s ease-out 0.2s both; }
    .anim-fade-2 { animation: fadeInUp 0.8s ease-out 0.5s both; }
    .anim-fade-3 { animation: fadeInUp 0.8s ease-out 0.8s both; }
    .anim-fade-4 { animation: fadeInUp 0.8s ease-out 1.1s both; }
    @media (prefers-reduced-motion: reduce) {
      .anim-snip, .anim-float, .anim-fade-1, .anim-fade-2, .anim-fade-3, .anim-fade-4 {
        animation: none !important;
      }
    }
  </style>
</head>
<body class="bg-[#0A0A0A] text-white min-h-screen flex items-center justify-center overflow-hidden relative" style="font-family: 'Plus Jakarta Sans', sans-serif;">
  
  <!-- Ambient glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-rose-600/5 rounded-full blur-[150px] pointer-events-none"></div>
  
  <div class="relative z-10 flex flex-col items-center text-center px-6 max-w-2xl">
    
    <!-- Massive 404 background text -->
    <div class="relative mb-4 anim-fade-1">
      <span class="text-[28vw] sm:text-[22vw] md:text-[18vw] font-black leading-none text-white/[0.03] select-none pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2" style="font-family: 'Playfair Display', serif; font-style: italic;">404</span>
      
      <!-- Scissors icon -->
      <div class="anim-snip anim-float relative z-10 py-8">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-20 h-20 sm:w-28 sm:h-28 text-[#E23744]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="6" cy="6" r="3"/>
          <circle cx="6" cy="18" r="3"/>
          <line x1="20" y1="4" x2="8.12" y2="15.88"/>
          <line x1="14.47" y1="14.48" x2="20" y2="20"/>
          <line x1="8.12" y1="8.12" x2="12" y2="12"/>
        </svg>
      </div>
    </div>

    <!-- 404 number -->
    <h1 class="text-8xl sm:text-9xl font-black tracking-tighter text-white/90 mb-4 anim-fade-1" style="font-family: 'Playfair Display', serif;">404</h1>
    
    <!-- Elegant tagline -->
    <p class="text-xl sm:text-2xl md:text-3xl text-stone-300 mb-4 anim-fade-2 leading-snug" style="font-family: 'Playfair Display', serif; font-style: italic;">
      Looks like this strand got snipped.
    </p>

    <!-- Body text -->
    <p class="text-sm sm:text-base text-stone-500 mb-10 max-w-md anim-fade-3 leading-relaxed">
      The page you're looking for has been trimmed away. Let's get you back to something beautiful.
    </p>

    <!-- CTA Button -->
    <a href="/hairport/user/home" class="anim-fade-4 inline-flex items-center gap-3 bg-[#E23744] hover:bg-[#CB202D] text-white font-bold text-xs uppercase tracking-[0.2em] px-10 py-4.5 rounded-full shadow-lg shadow-rose-900/30 transition-all duration-300 hover:scale-105 hover:shadow-xl hover:shadow-rose-900/40 active:scale-95 cursor-pointer">
      <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Return Home
    </a>

    <!-- Bottom links -->
    <div class="mt-12 flex items-center gap-6 text-[10px] font-bold uppercase tracking-widest text-stone-600 anim-fade-4">
      <a href="/hairport/user/terms" class="hover:text-stone-300 transition-colors cursor-pointer">Terms</a>
      <span class="text-stone-800">·</span>
      <a href="/hairport/user/privacy" class="hover:text-stone-300 transition-colors cursor-pointer">Privacy</a>
    </div>
  </div>

</body>
</html>
